# Combat Strike — environment template.
#
# Copy to `.env` in the repository root and adjust:
#   cp .env.example .env
# Docker Compose reads this file automatically; the API loads it from the
# repository root when the variable is not already exported in the shell.

# ---------------------------------------------------------------- database
# Credentials used by the `postgres` service in docker-compose.yml.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=combat_strike
# Host port published by docker-compose.yml.
POSTGRES_PORT=5432

# Connection string used by the API (must match the values above).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/combat_strike
# Maximum number of pooled connections.
DB_POOL_SIZE=10
# Set to true when the database requires TLS (managed providers, Neon, ...).
DB_SSL=false

# ---------------------------------------------------------------- api
# development | test | production. In production DATABASE_URL and
# JWT_SECRET are mandatory and JWT_SECRET must be at least 32 characters.
NODE_ENV=development
HOST=0.0.0.0
PORT=3001
# pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Comma separated list of allowed origins, or * for any origin.
CORS_ORIGIN=*

# ---------------------------------------------------------------- sessions
# HMAC key used to sign session tokens. CHANGE THIS before going live.
JWT_SECRET=dev-insecure-secret-change-me-please-000000
# Session lifetime in seconds (default: 7 days).
SESSION_TTL_SECONDS=604800

# ---------------------------------------------------------------- rate limit
# Global limit per client IP.
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
# Limit applied to /api/auth/register and /api/auth/login.
AUTH_RATE_LIMIT_MAX=20

# ---------------------------------------------------------------- passwords
# scrypt cost parameters. The defaults are safe; raise SCRYPT_N only after
# measuring the login latency on the target machine.
SCRYPT_N=16384
SCRYPT_R=8
SCRYPT_P=1
SCRYPT_KEYLEN=64

# ---------------------------------------------------------------- seed
# Account created by `npm run db:seed`.
SEED_EMAIL=demo@combat-strike.local
SEED_PASSWORD=demo-password-1234
